# Örnek .env dosyası — kendi değerlerinle kopyala: cp .env.example .env

# Ücretsiz LLM katmanı (senaryo + başlık agent'ları)
GROQ_API_KEY=

# TikTok keşif (TikTok-Api; opsiyonel)
TIKTOK_SESSIONID=

# Seslendirme (edge-tts; ücretsiz, key gerekmez)
EDGE_TTS_VOICE=tr-TR-AhmetNeural

# Kapak görseli motoru: pollinations | comfyui
COVER_ENGINE=pollinations

# Yayım (social-auto-upload; çerez oturumu)
TIKTOK_UPLOAD_USER=
